# Copy this file to .env and fill in the values.
# Never commit the real .env to Git.

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Extraction tasks (Part 1, Part 2 date extraction)
# 3.5 Flash-Lite: ~15 RPM / ~500 RPD observed on the development project's free-tier quota.
# Optimised for document parsing + structured output.
# Fallback to 3.1 Flash-Lite on quota/rate-limit errors (same quota tier, same capabilities).
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRACTION_FALLBACK_MODEL=gemini-3.1-flash-lite

# Reasoning tasks (Part 2 MCP tool selection + temporal classification)
# 3.5 Flash-Lite is the primary reasoning model — 500 RPD makes it reliably
# available throughout development. Complex tasks are decomposed into smaller
# structured steps (interpret → classify) rather than relying on a stronger model.
# No fallback by default; set GEMINI_REASONING_FALLBACK_MODEL to opt in.
GEMINI_REASONING_MODEL=gemini-3.5-flash-lite
# GEMINI_REASONING_FALLBACK_MODEL=gemini-3.1-flash-lite

# Absolute or relative path to the source PDF
SOURCE_PDF=data/fy2024_analysis_of_revenue_and_expenditure.pdf
