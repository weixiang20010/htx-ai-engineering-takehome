# Copy this file to .env and fill in the values.
# Never commit the real .env to Git.

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Structured extraction tasks (Part 1, Part 2 date extraction)
# 3.1 Flash Lite: 500 RPD free tier — ample for the take-home without touching reasoning quota.
# No fallback: extraction volume is predictable and well within the 500 RPD limit.
GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite

# Reasoning tasks (Part 2 MCP tool selection + temporal classification)
# 3.6 Flash: 20 RPD — protected by using 3.1 for extraction.
# Fallback to 3.1 Flash Lite on recoverable quota/rate-limit errors (same capabilities).
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_REASONING_FALLBACK_MODEL=gemini-3.1-flash-lite

# Absolute or relative path to the source PDF
SOURCE_PDF=data/fy2024_analysis_of_revenue_and_expenditure.pdf
