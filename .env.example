# Copy this file to .env and fill in the values.
# Never commit the real .env to Git.

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Lightweight model for extraction tasks (Part 1, Part 2 date extraction)
# Falls back to the stronger model on quota exhaustion
GEMINI_EXTRACTION_MODEL=gemini-3.1-flash-lite
GEMINI_EXTRACTION_FALLBACK_MODEL=gemini-3.6-flash

# Stronger model for reasoning tasks (Part 2 MCP tool selection + classification)
# Falls back to the lightweight model on quota exhaustion
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_REASONING_FALLBACK_MODEL=gemini-3.1-flash-lite

# Absolute or relative path to the source PDF
SOURCE_PDF=data/fy2024_analysis_of_revenue_and_expenditure.pdf
