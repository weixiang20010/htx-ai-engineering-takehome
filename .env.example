# Copy this file to .env and fill in the values.
# Never commit the real .env to Git.

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Lightweight model for extraction tasks (Part 1, Part 2 date extraction)
# 3.5 Flash-Lite is the current GA replacement for 3.1 Flash-Lite, optimised for
# high-volume document parsing and structured output at low latency/cost.
# Fallback stays within the same lightweight tier — avoids burning reasoning quota.
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
GEMINI_EXTRACTION_FALLBACK_MODEL=gemini-3.1-flash-lite

# Stronger model for reasoning tasks (Part 2 MCP tool selection + classification)
# Fallback degrades to 3.5 Flash-Lite — same class as extraction primary, not 3.1.
GEMINI_REASONING_MODEL=gemini-3.6-flash
GEMINI_REASONING_FALLBACK_MODEL=gemini-3.5-flash-lite

# Absolute or relative path to the source PDF
SOURCE_PDF=data/fy2024_analysis_of_revenue_and_expenditure.pdf
